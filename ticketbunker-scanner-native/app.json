{
  "expo": {
    "name": "TicketBunker Scanner",
    "slug": "ticketbunker-scanner",
    "scheme": "ticketbunkerscanner",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080e12",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "pt.soundbunker.ticketbunkerscanner",
      "supportsTablet": true,
      "buildNumber": "8",
      "infoPlist": {}
    },
    "android": {
      "package": "pt.soundbunker.ticketbunkerscanner",
      "versionCode": 5,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080e12"
      },
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TicketBunker Scanner to use your camera to scan event tickets.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      "./plugins/withLocalHub.cjs"
    ],
    "extra": {
      "apiBase": "https://www.soundbunker.pt",
      "eas": {
        "projectId": "332de5bb-6286-4dc1-b12c-a9ad88025624"
      }
    },
    "owner": "soundbunker"
  }
}
