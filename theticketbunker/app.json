{
  "expo": {
    "name": "TicketBunker",
    "slug": "theticketbunker",
    "scheme": "theticketbunker",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070b",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "pt.soundbunker.theticketbunker",
      "supportsTablet": true,
      "buildNumber": "5",
      "associatedDomains": [],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TicketBunker uses your location to find nearby events, transport stops and routes. Your coordinates are sent to TicketBunker and the map or transport provider for the search. Background location is not used.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pt.soundbunker.theticketbunker",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070b"
      },
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#07070b"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TicketBunker uses your location to find nearby events, transport stops and routes. Your coordinates are sent to TicketBunker and the map or transport provider for the search. Background location is not used.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "siteBase": "https://theticketbunker.com",
      "eas": {
        "projectId": "0027b9f4-e08e-4887-93b6-44f7bc8552b7"
      }
    },
    "owner": "soundbunker"
  }
}
