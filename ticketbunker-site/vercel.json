{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/[endpoint].js": {
      "maxDuration": 60,
      "regions": [
        "dub1"
      ]
    },
    "api/event-page.js": {
      "maxDuration": 30,
      "includeFiles": "event.html"
    },
    "api/event-scan.js": {
      "regions": [
        "dub1"
      ],
      "maxDuration": 30
    },
    "api/partner-feed.js": {
      "maxDuration": 60,
      "memory": 1024,
      "regions": [
        "dub1"
      ],
      "includeFiles": "partner-data/**"
    },
    "api/city-page.js": {
      "maxDuration": 20,
      "includeFiles": "{index.html,city-places.js}"
    },
    "api/partner-page.js": {
      "maxDuration": 60,
      "memory": 1024,
      "regions": [
        "dub1"
      ],
      "includeFiles": "{index.html,partner-data/**}"
    },
    "api/city-guide.js": {
      "maxDuration": 20,
      "includeFiles": "{index.html,city-guide.css,city-guide-data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:slug(london|manchester|liverpool|glasgow|edinburgh|birmingham|brighton|bristol|leeds|newcastle|sheffield|nottingham|cardiff|belfast|dublin|algarve|lisbon|porto|madeira|barcelona|madrid|seville|malaga|ibiza|tenerife|mallorca|paris|amsterdam|berlin|rome|prague|vienna|budapest|preston|chester|southampton|portsmouth|leicester|derby|coventry|wolverhampton|solihull|stoke-on-trent|milton-keynes|northampton|peterborough|cambridge|oxford|reading|norwich|colchester|chelmsford|southend|canterbury|maidstone|tunbridge-wells|guildford|worthing|bournemouth|salisbury|bath|exeter|plymouth|cheltenham|worcester|lincoln|york|hull|bradford|doncaster|middlesbrough|sunderland|carlisle|kendal|blackpool|bolton|wigan|warrington|stockport|aberdeen|dundee|stirling|inverness|swansea|newport|derry|cork|galway|limerick|albufeira|coimbra|braga|valencia|bilbao|granada|alicante|benidorm|marbella|gran-canaria|lanzarote|san-sebastian|nice|lyon|marseille|bordeaux|toulouse|milan|florence|venice|naples|bologna|turin|munich|hamburg|cologne|frankfurt|rotterdam|utrecht|brussels|antwerp|bruges|ghent|salzburg|zurich|geneva|copenhagen|stockholm|oslo|helsinki|tallinn|riga|vilnius|krakow|warsaw|gdansk|bratislava|ljubljana|zagreb|split|dubrovnik|bucharest|sofia|athens|thessaloniki|mykonos|santorini|crete|corfu|rhodes|malta|ayia-napa|paphos|limassol)",
      "destination": "/api/city-page?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-listings.xml",
      "destination": "/api/sitemap-listings"
    },
    {
      "source": "/admin",
      "destination": "/control-room"
    },
    {
      "source": "/events-admin",
      "destination": "/control-room"
    },
    {
      "source": "/login",
      "destination": "/account"
    },
    {
      "source": "/my-tickets",
      "destination": "/account"
    },
    {
      "source": "/client",
      "destination": "/account"
    },
    {
      "source": "/portal",
      "destination": "/account"
    },
    {
      "source": "/events",
      "destination": "/"
    },
    {
      "source": "/event/:slug",
      "destination": "/api/event-page?slug=:slug"
    },
    {
      "source": "/listing/:id",
      "destination": "/api/partner-page?id=:id"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/city-guide?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/terms#privacy",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/my-tickets.html",
      "destination": "/my-tickets",
      "permanent": true
    },
    {
      "source": "/portal.html",
      "destination": "/login",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
