{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/[endpoint].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/account"
    },
    {
      "source": "/my-tickets",
      "destination": "/account"
    },
    {
      "source": "/client",
      "destination": "/account"
    },
    {
      "source": "/portal",
      "destination": "/account"
    },
    {
      "source": "/events",
      "destination": "/"
    },
    {
      "source": "/event/:slug",
      "destination": "/event"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/terms#privacy",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/my-tickets.html",
      "destination": "/my-tickets",
      "permanent": true
    },
    {
      "source": "/portal.html",
      "destination": "/login",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
