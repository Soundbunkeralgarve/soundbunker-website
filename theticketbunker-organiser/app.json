{
  "expo": {
    "name": "TB Organiser",
    "slug": "theticketbunker-organiser",
    "scheme": "tborganiser",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080e12",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "pt.soundbunker.theticketbunker.organiser",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "TB Organiser uses your photos only when you choose an event poster to upload.",
        "NSCameraUsageDescription": "TB Organiser uses the camera only when you take a photo for an event poster.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "ticketbunkerscanner"
        ]
      }
    },
    "android": {
      "package": "pt.soundbunker.theticketbunker.organiser",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080e12"
      },
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#080e12"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TB Organiser uses your photos only when you choose an event poster to upload.",
          "cameraPermission": "TB Organiser uses the camera only when you take a photo for an event poster.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "siteBase": "https://theticketbunker.com"
    },
    "owner": "soundbunker"
  }
}
