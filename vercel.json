      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/book/recording-studio",
      "destination": "/recording.html",
