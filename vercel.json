    },
    {
      "source": "/event-scanner",
      "destination": "/event-scanner.html"
    },
    {
      "source": "/event-ticket",
      "destination": "/event-ticket.html"
    },
    {
      "source": "/event",
      "destination": "/event-public.html"
    },
    {
      "source": "/organiser",
      "destination": "/organiser.html"
    },
    {
      "source": "/event-test",
      "destination": "/event-free-test.html"
    },
    {
      "source": "/ticketbunker-dry-run",
      "destination": "/ticketbunker-dry-run.html"
    }
  ],
  "functions": {
    "api/event-scan.js": {
      "regions": [
        "dub1"
      ],
      "maxDuration": 30
    },
    "api/admin-prize-voucher.js": {
      "includeFiles": "api/_prize_templates/**"
    },
    "api/shop.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/ticketbunker-finance.js": {
      "maxDuration": 60
    },
    "api/ticketbunker-settle.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "includeFiles": "assets/soundbunker-email-footer.png"
    },
    "api/event-cancellation.js": {
      "maxDuration": 60
    },
    "api/ticketbunker-cancellations.js": {
      "maxDuration": 300
    },
    "api/ticketbunker-stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/event-postponement.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/ticketbunker-organiser-mail",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/premium-mail-reconcile",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/ticketbunker-settle",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ticketbunker-cancellations",
      "schedule": "* * * * *"
    }
  ],
  "regions": [
    "dub1"
  ]
}
