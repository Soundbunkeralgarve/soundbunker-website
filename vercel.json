{
  "redirects": [
    {
      "source": "/events",
      "destination": "https://theticketbunker.com/events",
      "permanent": false
    },
    {
      "source": "/events.html",
      "destination": "https://theticketbunker.com/events",
      "permanent": false
    },
    {
      "source": "/organiser",
      "destination": "https://theticketbunker.com/organiser",
      "permanent": false
    },
    {
      "source": "/organiser.html",
      "destination": "https://theticketbunker.com/organiser",
      "permanent": false
    },
    {
      "source": "/event",
      "destination": "https://theticketbunker.com/event",
      "permanent": false
    },
    {
      "source": "/event-public.html",
      "destination": "https://theticketbunker.com/event",
      "permanent": false
    },
    {
      "source": "/event-test",
      "destination": "https://theticketbunker.com/",
      "permanent": false
    },
    {
      "source": "/event-free-test.html",
      "destination": "https://theticketbunker.com/",
      "permanent": false
    },
    {
      "source": "/ticketbunker-dry-run",
      "destination": "https://theticketbunker.com/",
      "permanent": false
    },
    {
      "source": "/ticketbunker-dry-run.html",
      "destination": "https://theticketbunker.com/",
      "permanent": false
    },
    {
      "source": "/event-ticket",
      "destination": "https://theticketbunker.com/event-ticket",
      "permanent": false
    },
    {
      "source": "/event-ticket.html",
      "destination": "https://theticketbunker.com/event-ticket",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rules",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/shop.html",
      "permanent": true
    },
    {
      "source": "/shop/",
      "destination": "/shop.html",
      "permanent": true
    },
    {
      "source": "/:page(hub-academy|hub-culture){.html}?{/}?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:page(recording|voiceover|experiences-parties|parties){.html}?{/}?",
      "destination": "/#relocation",
      "permanent": false
    },
    {
      "source": "/gift-vouchers{.html}?{/}?",
      "destination": "/redeem",
      "permanent": false
    },
    {
      "source": "/book/recording-studio{/}?",
      "destination": "/#relocation",
      "permanent": false
    },
    {
      "source": "/:page(production|photography|blog|record-label){/}?",
      "destination": "/:page.html",
      "permanent": false
    },
    {
      "source": "/retreats.html",
      "destination": "/retreats",
      "permanent": false
    },
    {
      "source": "/retreats/",
      "destination": "/retreats",
      "permanent": false
    },
    {
      "source": "/mixing-mastering{/}?",
      "destination": "/mixing-mastering.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/download/:product/:os",
      "destination": "/api/licence?action=download&product=:product&os=:os"
    },
    {
      "source": "/plugins",
      "destination": "/plugins.html"
    },
    {
      "source": "/retreats",
      "destination": "/retreats.html"
    },
    {
      "source": "/client",
      "destination": "/client.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/redeem",
      "destination": "/redeem.html"
    },
    {
      "source": "/events-admin",
      "destination": "/events-admin.html"
    },
    {
      "source": "/event-scanner",
      "destination": "/event-scanner.html"
    },
    {
      "source": "/event-ticket",
      "destination": "/event-ticket.html"
    }
  ],
  "functions": {
    "api/event-scan.js": {
      "regions": [
        "dub1"
      ],
      "maxDuration": 30
    },
    "api/admin-prize-voucher.js": {
      "includeFiles": "api/_prize_templates/**"
    },
    "api/shop.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/ticketbunker-finance.js": {
      "maxDuration": 60
    },
    "api/ticketbunker-settle.js": {
      "maxDuration": 60
    },
    "api/event-cancellation.js": {
      "maxDuration": 60
    },
    "api/ticketbunker-cancellations.js": {
      "maxDuration": 300
    },
    "api/ticketbunker-stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/event-postponement.js": {
      "maxDuration": 60
    },
    "api/invoice-reconcile.js": {
      "maxDuration": 300
    },
    "api/invoice-payment.js": {
      "maxDuration": 90
    },
    "api/ask-studio.js": {
      "maxDuration": 60
    },
    "api/whatsapp-webhook.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "includeFiles": "assets/soundbunker-email-footer.png"
    }
  },
  "crons": [
    {
      "path": "/api/ticketbunker-organiser-mail",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/premium-mail-reconcile",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/ticketbunker-settle",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ticketbunker-cancellations",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/invoice-reconcile",
      "schedule": "* * * * *"
    }
  ],
  "regions": [
    "dub1"
  ]
}
